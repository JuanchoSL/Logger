{
    "name": "juanchosl/logger",
    "description": "Little logger using the PSR interfaces",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JuanchoSL/Logger",
    "keywords": [
        "log",
        "debug"
    ],
    "authors": [
        {
            "name": "Juan Sánchez Lecegui",
            "email": "Juan.Sanchez@tecnicosweb.com",
            "homepage": "https://www.linkedin.com/in/juansanchezlecegui/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "psr/log": "3.0.*",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.*"
    },
    "autoload": {
        "psr-4": {
            "JuanchoSL\\Logger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuanchoSL\\Logger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit --configuration phpunit.xml tests",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon"
    }
}